{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "jsx": "react-jsx", "strict": true,
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src", "ui", "tests"]
}
